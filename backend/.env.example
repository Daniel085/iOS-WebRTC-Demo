# Environment Configuration
NODE_ENV=development

# Server Port
# REST API and Socket.IO signaling share ONE port. PaaS platforms (Fly.io,
# Render, Railway) inject PORT automatically; API_PORT is a fallback.
PORT=3000

# Database Configuration
# SKIP_DATABASE=true  -> in-memory mock models; users, tokens and calls are lost
#                        on every restart (quick testing only).
# SKIP_DATABASE=false -> PostgreSQL via the DB_* settings below. Tables are
#                        created automatically on first start in development.
#                        See README.md "Setup Database" for the one-time local setup.
SKIP_DATABASE=true

# PostgreSQL settings (used when SKIP_DATABASE=false)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webrtc_dialer
DB_USER=postgres
DB_PASSWORD=postgres
# Hosted databases usually hand out one connection string instead; when set
# it replaces the five DB_* settings above.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true      # require TLS to the database (managed/public databases)
# DB_SYNC=true     # create missing tables at start when NODE_ENV=production

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# SMS Verification Provider (mock, twilio, aws-sns, firebase)
SMS_PROVIDER=mock

# Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# AWS Configuration (if using AWS SNS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Apple Push Notifications
# Auth method: 'token' or 'cert'
APN_AUTH_METHOD=token

# Token-based auth (recommended)
APN_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
# On hosts without a key file (Fly.io, Render), set APN_KEY to the .p8 file contents instead of APN_KEY_PATH.
# APN_KEY=
APN_KEY_ID=XXXXXXXXXX
APN_TEAM_ID=XXXXXXXXXX
# APNs gateway: defaults to production when NODE_ENV=production. Xcode development builds register
# SANDBOX tokens, so set APN_PRODUCTION=false for them; TestFlight/App Store builds need true.
# APN_PRODUCTION=false

# Certificate-based auth (alternative)
# APN_CERT_PATH=./certs/voip_cert.pem
# APN_KEY_PATH=./certs/voip_key.pem

# VoIP Bundle ID
VOIP_BUNDLE_ID=com.yourcompany.webrtcdialer.voip

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Logging
LOG_LEVEL=info
LOGS_DIR=./logs

# Redis (optional - for production)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting (per client IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Auth endpoints (send-code / verify-code). Raise this when testing several
# simulators/devices from one IP.
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ---------------------------------------------------------------------------
# SIP gateway (docs/SIP_INTEGRATION.md, backend/asterisk/README.md)
# ---------------------------------------------------------------------------
# Route calls to non-app destinations (E.164 numbers, sip: URIs, Asterisk
# feature codes such as *43) through Asterisk instead of failing them.
SIP_ENABLED=false
# SIP over WebSocket endpoint of Asterisk. ws:// is fine on localhost / inside
# docker-compose (ws://asterisk:8088/ws); use wss://host:8089/ws otherwise.
ASTERISK_WSS_URL=wss://localhost:8089/ws
# SIP domain used in user URIs (sip:user_1555...@ASTERISK_DOMAIN); defaults to the URL host.
ASTERISK_DOMAIN=localhost
# Per-user SIP passwords are HMAC(SIP_GATEWAY_SECRET, username). Required when enabled.
SIP_GATEWAY_SECRET=change-me-sip-gateway-secret
# Accept Asterisk's self-signed certificate (prototype only).
ASTERISK_TLS_INSECURE=true
# How long to wait for the app's ICE candidates before sending the INVITE (no trickle ICE toward SIP).
SIP_ICE_GATHER_TIMEOUT_MS=2000
# Provisioning: where to write the generated endpoints and how to reload Asterisk.
ASTERISK_USERS_CONF=./asterisk/etc/pjsip_users.conf
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=gateway
ASTERISK_AMI_SECRET=change-me-gateway-ami
# JsSIP protocol-level logging
SIP_DEBUG=false

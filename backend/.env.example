# Environment Configuration
NODE_ENV=development

# Server Ports
API_PORT=3000
SIGNALING_PORT=3001

# Database Configuration
# TODO: Set SKIP_DATABASE=false and configure PostgreSQL for production
# Currently running without database for quick testing
SKIP_DATABASE=true

# PostgreSQL settings (re-enable when ready)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webrtc_dialer
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# SMS Verification Provider (mock, twilio, aws-sns, firebase)
SMS_PROVIDER=mock

# Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# AWS Configuration (if using AWS SNS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Apple Push Notifications
# Auth method: 'token' or 'cert'
APN_AUTH_METHOD=token

# Token-based auth (recommended)
APN_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
APN_KEY_ID=XXXXXXXXXX
APN_TEAM_ID=XXXXXXXXXX

# Certificate-based auth (alternative)
# APN_CERT_PATH=./certs/voip_cert.pem
# APN_KEY_PATH=./certs/voip_key.pem

# VoIP Bundle ID
VOIP_BUNDLE_ID=com.yourcompany.webrtcdialer.voip

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Logging
LOG_LEVEL=info
LOGS_DIR=./logs

# Redis (optional - for production)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
